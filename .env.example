# ═══════════════════════════════════════════════════════
# NexVault Protocol — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ═══════════════════════════════════════════════════════

# Nexus Mainnet
NEXUS_RPC_URL=           # Nexus mainnet RPC endpoint (from docs.nexus.xyz)
NEXUS_CHAIN_ID=          # Nexus mainnet chain ID
PRIVATE_KEY=             # Deployer private key (must be OWNER address)

# Deployed Contract Addresses (fill after deploy)
USDX_ADDRESS=            # USDX token contract on Nexus
GYDS_ADDRESS=            # GYDS distributor address on Nexus
VAULT_ADDRESS=           # USDXVault after deploy
BADGE_ADDRESS=           # VaultGenesisBadge after deploy
REGISTRY_ADDRESS=        # ReferralRegistry after deploy
COMPOUNDER_ADDRESS=      # AutoCompounder after deploy
NEXCREDIT_ADDRESS=       # NexCredit after deploy

# Optional
REPORT_GAS=false         # Set to true for gas reporting
